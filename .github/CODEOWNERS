# These paths affect release contents, installation, security and user privacy, so review requests
# should include the repository owner even when ordinary code changes do not.
#
# This file only takes effect once the branch ruleset requires code owner review.

# The release pipeline itself, and everything CI trusts.
/.github/                       @daodeqing

# What ends up on the user's disk, and how it is installed and registered.
/installer/                     @daodeqing
/scripts/                       @daodeqing

# Which engine and which dictionary release this product ships.
/product-lock.json              @daodeqing
/version.txt                    @daodeqing
/.gitmodules                    @daodeqing
/vendor/                        @daodeqing

# Statements users rely on. Changing what these promise is not a routine edit.
/PRIVACY.md                     @daodeqing
/SECURITY.md                    @daodeqing
/LICENSE                        @daodeqing
/THIRD_PARTY_NOTICES.txt        @daodeqing
