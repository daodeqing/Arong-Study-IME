#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @MSIME_PRODUCT_VERSION_COMMAS@,0
 PRODUCTVERSION @MSIME_PRODUCT_VERSION_COMMAS@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Arong Study IME"
            VALUE "FileVersion", "@MSIME_PRODUCT_VERSION@.0"
            VALUE "ProductName", "Arong Study IME"
            VALUE "ProductVersion", "@MSIME_PRODUCT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
